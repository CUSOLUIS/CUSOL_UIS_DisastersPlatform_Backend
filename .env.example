# Configuración exclusiva para desarrollo local.
POSTGRES_DB=disasters
POSTGRES_USER=disasters
POSTGRES_PASSWORD=change-me-for-local-development
GATEWAY_PORT=8000
FRONTEND_PORT=3100

# CHG-007: clave local de cifrado para campos privados de reportes.
# Cambiarla en .env; nunca usar este valor fuera de desarrollo.
REPORT_ENCRYPTION_KEY=dev-local-only-report-key

# CHG-022: identidad y sesiones (solo desarrollo local).
SESSION_TTL_HOURS=24
VERIFICATION_TTL_HOURS=24
SESSION_COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
MAILPIT_UI_PORT=8025

# CHG-036: correo inicial de desarrollo. La contraseña debe guardarse en
# $HOME/.cusol-secrets/admin_password con permisos 0600; nunca aquí ni en Git.
ADMIN_BOOTSTRAP_EMAIL=admin@cusol.local
ADMIN_BOOTSTRAP_RECONCILE=false
ADMIN_BOOTSTRAP_ROTATE_PASSWORD=false
# Ajusta estos dos valores con `id -u` e `id -g` si tu usuario local difiere.
ADMIN_BOOTSTRAP_UID=1001
ADMIN_BOOTSTRAP_GID=1001

# Cambiar a `api` cuando Claude entregue y valide /api/v1/admin.
ADMIN_DATA_MODE=demo

# CHG-036: límites administrativos del gateway (por cuenta autenticada)
# y vigencia máxima del acceso temporal a evidencia (tope 300 s).
ADMIN_RATE_LIMIT_PER_MINUTE=240
ADMIN_EVIDENCE_RATE_LIMIT_PER_MINUTE=30
EVIDENCE_GRANT_TTL_SECONDS=300
